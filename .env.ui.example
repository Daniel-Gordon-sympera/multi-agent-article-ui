# Sympera Scout — UI service variables.
#
# WHERE THEY GO. The UI joins the pipeline's Compose project, so these lines are
# added to the PIPELINE repository's `.env` (the one next to its compose.yaml,
# which already holds POSTGRES_PASSWORD, API_BOOTSTRAP_KEY, API_DOMAIN, ...).
# For local development without Docker, copy this file to `.env.ui` at the root
# of THIS repository instead: the BFF reads `.env.ui` when present (contract §4.1).
# Never commit `.env` or `.env.ui`.
#
# Random values: `openssl rand -hex 24` for passwords (hex is safe inside database
# URLs), `openssl rand -hex 32` for SESSION_SECRET.
#
# THE TWO PIPELINE API KEYS. The BFF never shows a key to the browser; it calls the
# pipeline API with one of two keys chosen by the signed-in user's role
# (admin/operator -> operator key, viewer -> reader key). Create them once with
# the pipeline's bootstrap key (API_BOOTSTRAP_KEY in the pipeline's .env; see the
# pipeline README, "Platform operation > Start and inspect": "The initial operator
# key is API_BOOTSTRAP_KEY; create separate operator or reader keys through
# /v1/api-keys"). The `key` field of each 201 response is shown exactly once:
#
#   curl -sS -X POST http://127.0.0.1:8000/v1/api-keys \
#        -H "X-API-Key: $API_BOOTSTRAP_KEY" -H "Content-Type: application/json" \
#        -d '{"name": "scout-ui-operator", "role": "operator"}'
#   curl -sS -X POST http://127.0.0.1:8000/v1/api-keys \
#        -H "X-API-Key: $API_BOOTSTRAP_KEY" -H "Content-Type: application/json" \
#        -d '{"name": "scout-ui-reader", "role": "reader"}'
#
# Rotation: create two new keys, replace the values below, `docker compose up -d ui`,
# then `DELETE /v1/api-keys/<old-name>` (HOWTO.md §11).

# ---------------------------------------------------------------------------
# Database (schema `ui` inside the pipeline's PostgreSQL)
# ---------------------------------------------------------------------------
# Password of the login role `app_ui` (granted `svc_ui`, owner of schema `ui`).
# Bootstrap (ui_migrate) creates or alters the role with this password; the `ui`
# service connects with it. Compose builds UI_DATABASE_URL from it, so the URL
# itself is only set by hand for local development:
#   UI_DATABASE_URL=postgresql+psycopg://app_ui:<pw>@localhost:5432/article_pipeline
# (the bootstrap command needs the OWNER url instead:
#   postgresql+psycopg://article_owner:<POSTGRES_PASSWORD>@localhost:5432/article_pipeline)
UI_DATABASE_PASSWORD=
# UI_DATABASE_URL=

# ---------------------------------------------------------------------------
# Pipeline API (required)
# ---------------------------------------------------------------------------
# Base URL of the pipeline API as seen from the BFF. Compose sets http://api:8000;
# for local development use the published port, e.g. http://127.0.0.1:8000.
# PIPELINE_API_URL=http://127.0.0.1:8000
# The two keys created above (roles operator and reader). Registered as secrets for
# log redaction; never sent to the browser.
PIPELINE_OPERATOR_KEY=
PIPELINE_READER_KEY=

# ---------------------------------------------------------------------------
# Sessions and cookies
# ---------------------------------------------------------------------------
# HMAC key for the signed `scout_session` cookie value (itsdangerous). At least
# 32 characters; changing it signs every user out.
SESSION_SECRET=
# Absolute origin used for links in responses. Compose derives it from UI_DOMAIN
# (https://<UI_DOMAIN>); default http://localhost:8080.
# UI_PUBLIC_URL=http://localhost:8080
# `true` (default) marks the cookie Secure; set `false` only for plain-http local
# development (e.g. the Vite dev server on http://localhost:5173).
# UI_SECURE_COOKIES=true
# Session lifetimes: idle (sliding) and absolute. Defaults 12 hours / 7 days.
# UI_SESSION_IDLE_HOURS=12
# UI_SESSION_ABSOLUTE_DAYS=7

# ---------------------------------------------------------------------------
# First administrator (used only while ui.users is empty)
# ---------------------------------------------------------------------------
# Bootstrap creates this account with must_change_password = true; the first
# sign-in forces a new password. Remove the password from .env afterwards.
UI_BOOTSTRAP_ADMIN_EMAIL=
UI_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------
# Days of ui.audit_log kept by the hourly retention task (default 180).
# UI_AUDIT_RETENTION_DAYS=180
# How often the BFF re-reads the pipeline's /openapi.json to refresh the
# capability map (B1-B4 probes). Default 300 seconds.
# UI_CAPABILITY_REFRESH_SECONDS=300
# Logging: level INFO (default) and format `json` (Compose) or `console` (dev).
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Tests (developers only)
# ---------------------------------------------------------------------------
# Owner URL of a disposable database for the BFF integration tests; the suite
# skips them with a reason when unset. Never point this at production.
# UI_TEST_DATABASE_URL=postgresql+psycopg://scout_test:scout_test@localhost:5432/scout_test

# ---------------------------------------------------------------------------
# Compose-only (read by compose.ui.yaml, not by the BFF)
# ---------------------------------------------------------------------------
# Tag of the image built from this repository: scout-ui:${UI_IMAGE_TAG}. Use a
# release tag (e.g. 0.1.0) for deployments; `local` for `--build` on a dev box.
# UI_IMAGE_TAG=local
# Host port bound on 127.0.0.1 for direct (non-Caddy) access to the BFF.
# UI_PORT=8080
# Hostname Caddy serves the console on (deploy/Caddyfile.ui). `*.localhost` names
# get an internally-signed certificate; a public name gets Let's Encrypt.
# UI_DOMAIN=scout.localhost
